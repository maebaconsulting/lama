              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "erreur"
        ]
      },
      "Theme": {
        "type": "object",
        "properties": {
          "fond": {
            "type": "string",
