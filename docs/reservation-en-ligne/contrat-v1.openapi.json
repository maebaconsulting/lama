    "/essai/demande/{id}": {
      "get": {
        "summary": "Mode essai : état brut d'une demande",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "example": "d_7Kq2"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Demande",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "cliente": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "nom": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "pattern": "^(?=.{1,120}$)(?=.*\\p{L})[\\p{L}\\p{M}'’-]+\\.?(?: [\\p{L}\\p{M}'’-]+\\.?){0,7}$"
                        },
                        "prenom": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 60,
                          "pattern": "^(?=.*\\p{L})[\\p{L}\\p{M}'’-]+\\.?(?: [\\p{L}\\p{M}'’-]+\\.?){0,2}$"
                        },
                        "telephone": {
                          "type": "string",
                          "pattern": "^\\+[1-9]\\d{6,14}$"
                        },
                        "langue": {
                          "type": "string",
                          "enum": [
                            "fr",
                            "en"
                          ]
                        }
                      },
                      "required": [
                        "nom",
                        "telephone",
                        "langue"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "nullable": true
                    },
                    "accusee_le": {
                      "type": "integer",
                      "nullable": true
                    },
                    "decision": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Decision"
                        },
                        {
                          "nullable": true
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "cliente",
                    "note",
                    "accusee_le",
                    "decision"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Signature, horodatage ou salon refusés",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          },
          "403": {
            "description": "Salon suspendu sur l'application",
            "content": {
