          },
          "application": {
            "type": "object",
            "properties": {
              "nom": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "nom",
              "version"
            ]
          },
          "version_offre": {
            "type": "integer",
            "nullable": true
          },
          "version_disponibilites": {
            "type": "integer",
            "nullable": true
          },
          "demandes_en_attente": {
            "type": "integer"
          },
          "mode_essai": {
            "type": "boolean"
          }
        },
        "required": [
          "contrat",
          "application",
          "version_offre",
          "version_disponibilites",
          "demandes_en_attente",
          "mode_essai"
        ]
      },
      "Erreur": {
        "type": "object",
        "properties": {
          "erreur": {
            "type": "object",
