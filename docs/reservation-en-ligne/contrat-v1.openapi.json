{
  "openapi": "3.0.0",
  "info": {
    "title": "Contrat lama v1 : réservation en ligne",
    "version": "1.0.0",
    "description": "Contrat entre lama et une application de réservation, salon par salon (X-Lama-Institut). La signature, le découpage des plages et la capacité « Sans préférence » sont décrits dans contrat-v1.md."
  },
  "servers": [
    {
      "url": "https://reserver.exemple.com/lama/v1"
    }
  ],
  "security": [
    {
      "X-Lama-Institut": [],
      "X-Lama-Horodatage": [],
      "X-Lama-Signature": []
    }
  ],
  "components": {
    "securitySchemes": {
      "X-Lama-Institut": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lama-Institut"
      },
      "X-Lama-Horodatage": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lama-Horodatage"
      },
      "X-Lama-Signature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lama-Signature"
      }
    },
    "schemas": {
