          "police": {
            "type": "string",
            "enum": [
              "lama",
              "classique",
              "elegante",
              "moderne"
            ]
          }
        },
        "required": [
          "fond",
          "accent",
          "police"
        ]
      },
      "Affichage": {
        "type": "object",
        "properties": {
          "entete": {
            "type": "boolean"
          },
          "largeur": {
            "type": "string",
            "enum": [
              "colonne",
              "pleine"
            ]
          }
        },
        "required": [
