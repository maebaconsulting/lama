              "minItems": 2,
              "maxItems": 2
            },
            "maxItems": 2
          },
          "sam": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "maxItems": 2
          },
          "dim": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "maxItems": 2
          }
        },
        "required": [
          "lun",
          "mar",
          "mer",
          "jeu",
          "ven",
          "sam",
          "dim"
