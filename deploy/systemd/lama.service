[Unit]
Description=lama, application de l'institut
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lama
Group=lama
WorkingDirectory=/opt/lama/actuelle
Environment=NODE_ENV=production
Environment=HOME=/var/lib/lama
Environment=RCLONE_CONFIG=/var/lib/lama/rclone/rclone.conf
ExecStart=/usr/bin/node /opt/lama/actuelle/dist-server/main.mjs
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /mnt entier et non /mnt/lama-sauvegarde : disque absent, ce point de montage automatique
# répond « No such device » et systemd 259 (Ubuntu 26.04) refuse alors de démarrer le service,
# préfixe « - » compris (vu le 21/10/2026). /mnt reste à root : le compte lama n'y écrit que sur le disque.
ReadWritePaths=/var/lib/lama -/mnt
ReadOnlyPaths=/etc/lama

[Install]
WantedBy=multi-user.target
