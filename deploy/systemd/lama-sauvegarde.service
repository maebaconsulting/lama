[Unit]
Description=lama, sauvegarde de la base
After=lama.service

[Service]
Type=oneshot
User=lama
Group=lama
WorkingDirectory=/opt/lama/actuelle
Environment=NODE_ENV=production
Environment=HOME=/var/lib/lama
Environment=RCLONE_CONFIG=/var/lib/lama/rclone/rclone.conf
ExecStart=/usr/bin/node /opt/lama/actuelle/dist-server/cli.mjs sauvegarder
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /mnt entier et non /mnt/lama-sauvegarde : disque absent, ce point de montage automatique
# répond « No such device » et systemd 259 (Ubuntu 26.04) refuse alors de démarrer le service,
# préfixe « - » compris (vu le 21/10/2026). /mnt reste à root : le compte lama n'y écrit que sur le disque.
ReadWritePaths=/var/lib/lama -/mnt
ReadOnlyPaths=/etc/lama
