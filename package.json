{
  "name": "lama",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "LAMA_DEV=1 LAMA_DEMO=1 concurrently -n ui,api -c cyan,green \"vite --host\" \"tsx watch src/server/main.ts\"",
    "build": "vite build && pnpm run build:server",
    "build:server": "esbuild src/server/main.ts src/server/cli.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist-server --out-extension:.js=.mjs --banner:js=\"import { createRequire as lamaCreateRequire } from 'node:module'; const require = lamaCreateRequire(import.meta.url);\" && node --experimental-strip-types src/server/caisse/copier-ressources.ts dist-server/ticket",
    "start": "node dist-server/main.mjs",
    "build:relais": "vite build --config relais/vite.config.ts",
    "relais": "node --experimental-strip-types relais/node.ts",
    "relais:openapi": "node --experimental-strip-types relais/outils/exporter-openapi.ts",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts' 'relais/**/*.test.ts'",
    "paquet": "bash deploy/fabriquer-paquet.sh"
  },
  "dependencies": {
    "@clawnify/app": "^0.2.1",
    "@clawnify/db": "^0.4.2",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^0.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "age-encryption": "^0.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "hono": "^4.6.0",
    "jpeg-js": "^0.4.4",
    "lucide-preact": "^0.575.0",
    "lucide-react": "^1.7.0",
    "pdfkit": "0.20.2",
    "pngjs": "^7.0.0",
    "preact": "^10.25.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^4.2.2",
    "uqr": "0.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/pdfkit": "0.17.6",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
